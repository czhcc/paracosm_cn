    "primaryColor": "#dc2626",
    "accentColor": "#f97316",
    "cssVariables": {
      "--bg-primary": "#0a0a0f",
      "--bg-secondary": "#14141f",
      "--text-primary": "#e5e5e5",
      "--accent": "#dc2626"
    }
  },
