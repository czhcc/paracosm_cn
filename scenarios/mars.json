  "knowledgeRef": "mars-knowledge.json",
  "dataDrivenHooks": {
    "progressionPhysics": "mars-radiation-bone",
    "directorInstructions": "你是火星殖民地仿真的危机导演。观察殖民地状态，生成考验弱点、承接既往决策后果并形成叙事张力的危机。\n\n规则：\n1. 每场危机恰有 2～3 个选项，稳定 ID 为 option_a、option_b、option_c。\n2. 恰有一个选项标记 isRisky: true，具有更高潜在收益与更大潜在损失。\n3. 危机依据真实火星科学，包括辐射、重力、大气、心理学和政治。\n4. 不得重复上一回合的危机类别。\n5. 后续危机引用之前决策的后果并逐步升级。\n6. 根据殖民地状态校准难度：困难中的殖民地面临可生存的危机，繁荣殖民地面临生存级挑战。\n7. 描述包含殖民地的实际人口、士气、食物等数值。\n8. 每场危机指定 2～4 个分析部门。\n\n危机 category：\n- environmental：辐射、沙尘暴、地震、大气事件。\n- resource：水、食物、电力、氧气和材料短缺。\n- medical：疾病、伤害、骨密度、辐射病、流行病。\n- psychological：士气、隔离、代际矛盾、悲伤、倦怠。\n- political：地球关系、独立、治理争议、派系。\n- infrastructure：栖息舱损伤、生命保障故障、建设。\n- social：出生、教育、文化认同、代际冲突。\n- technological：设备故障、通信、AI 系统。\n\nrelevantDepartments 仅可使用以下精确 ID：medical、engineering、agriculture、psychology、governance。不得使用其他部门名，每次选 2～4 个。\n\n仅返回有效 JSON，例如：\n{\"title\":\"危机标题\",\"crisis\":\"包含具体殖民地数值的完整描述\",\"options\":[{\"id\":\"option_a\",\"label\":\"方案甲\",\"description\":\"方案的作用\",\"isRisky\":false},{\"id\":\"option_b\",\"label\":\"方案乙\",\"description\":\"更高潜在收益与更大风险\",\"isRisky\":true}],\"riskyOptionId\":\"option_b\",\"riskSuccessProbability\":0.55,\"category\":\"environmental\",\"researchKeywords\":[\"火星沙尘暴\",\"栖息舱压力\"],\"relevantDepartments\":[\"engineering\",\"medical\"],\"turnSummary\":\"用一句话说明危机如何源自之前的事件\"}\n所有人类可读文本使用简体中文；JSON 键、枚举、部门 ID、指标标识及代码保持协议格式。",
    "departments": {
      "medical": {
        "heading": "健康：",
        "chips": [
          {
            "label": "平均辐射量",
            "agg": {
              "fn": "avg",
              "field": "health.cumulativeRadiationMsv",
              "where": {
                "agent": "health.alive",
                "op": "==",
                "value": true
              }
            },
            "format": "number"
          },
          {
            "label": "平均骨密度",
            "agg": {
              "fn": "avg",
              "field": "health.boneDensityPct",
              "where": {
                "agent": "health.alive",
                "op": "==",
                "value": true
              }
            },
            "format": "percent"
          },
          {
            "label": "火星出生者",
            "agg": {
              "fn": "count",
              "where": {
                "all": [
                  {
                    "agent": "health.alive",
                    "op": "==",
                    "value": true
                  },
                  {
                    "agent": "core.marsborn",
                    "op": "==",
                    "value": true
                  }
                ]
              }
            },
            "format": "number"
          }
        ],
        "featuredRoster": {
          "header": "FEATURED:",
          "filter": {
            "all": [
              {
                "agent": "health.alive",
                "op": "==",
                "value": true
              },
              {
                "agent": "narrative.featured",
                "op": "==",
                "value": true
              }
            ]
          },
          "limit": 6,
          "template": "- {{name}}（{{age}} 岁）：骨密度 {{health.boneDensityPct}}%，累积辐射 {{health.cumulativeRadiationMsv}} mSv，心理状况 {{health.psychScore}}"
        }
      },
      "engineering": {
        "heading": "基础设施：",
        "chips": [
          {
            "label": "模块",
            "source": "metrics.infrastructureModules",
            "format": "number"
          },
          {
            "label": "功率",
            "source": "metrics.powerKw",
            "format": "number"
          },
          {
            "label": "生命保障容量",
            "source": "metrics.lifeSupportCapacity",
            "format": "number"
          },
          {
            "label": "人口",
            "source": "metrics.population",
            "format": "number"
          },
          {
            "label": "容积（立方米）",
            "source": "metrics.pressurizedVolumeM3",
            "format": "number"
          },
          {
            "label": "每日供水量（升）",
            "source": "metrics.waterLitersPerDay",
            "format": "number"
          }
        ]
      },
      "agriculture": {
        "heading": "食物：",
        "chips": [
          {
            "label": "储备（月）",
            "source": "metrics.foodMonthsReserve",
            "format": "number"
          },
          {
            "label": "需供养人口",
            "source": "metrics.population",
            "format": "number"
          },
          {
            "label": "模块",
            "source": "metrics.infrastructureModules",
            "format": "number"
          }
        ]
      },
      "psychology": {
        "heading": "心理：",
        "chips": [
          {
            "label": "士气",
            "source": "metrics.morale",
            "format": "percent"
          },
          {
            "label": "平均心理状况",
            "agg": {
              "fn": "avg",
              "field": "health.psychScore",
              "where": {
                "agent": "health.alive",
                "op": "==",
                "value": true
              }
            },
            "format": "number"
          },
          {
            "label": "情绪低落者",
            "agg": {
              "fn": "count",
              "where": {
                "all": [
                  {
                    "agent": "health.alive",
                    "op": "==",
                    "value": true
                  },
                  {
                    "agent": "health.psychScore",
                    "op": "<",
                    "value": 0.5
                  }
                ]
              }
            },
            "format": "number"
          },
          {
            "label": "火星出生者",
            "agg": {
              "fn": "count",
              "where": {
                "all": [
                  {
                    "agent": "health.alive",
                    "op": "==",
                    "value": true
                  },
                  {
                    "agent": "core.marsborn",
                    "op": "==",
                    "value": true
                  }
                ]
              }
            },
            "format": "number"
          }
        ],
        "featuredRoster": {
          "header": "SOCIAL:",
          "filter": {
            "all": [
              {
                "agent": "health.alive",
                "op": "==",
                "value": true
              },
              {
                "agent": "narrative.featured",
                "op": "==",
                "value": true
              }
            ]
          },
          "limit": 4,
          "template": "- {{name}}: psych {{health.psychScore}}"
        }
      },
      "governance": {
        "heading": "政治：",
        "chips": [
          {
            "label": "地球依赖程度",
            "source": "politics.earthDependencyPct",
            "format": "number"
          },
          {
            "label": "状态",
            "source": "statuses.governanceStatus",
            "format": "string"
          },
          {
            "label": "独立诉求压力",
            "source": "politics.independencePressure",
            "format": "percent"
          },
          {
            "label": "存活的火星出生者",
            "agg": {
              "fn": "count",
              "where": {
                "all": [
                  {
                    "agent": "health.alive",
                    "op": "==",
                    "value": true
                  },
                  {
                    "agent": "core.marsborn",
                    "op": "==",
                    "value": true
                  }
                ]
              }
            },
            "format": "number"
          },
          {
            "label": "存活总数",
            "agg": {
              "fn": "count",
              "where": {
                "agent": "health.alive",
                "op": "==",
                "value": true
              }
            },
            "format": "number"
          }
        ]
      }
    },
