{
  "id": "mars-genesis",
  "sourceUrl": "https://github.com/framerslab/paracosm/blob/master/scenarios/mars.json",
  "version": "3.0.0",
  "engineArchetype": "closed_turn_based_settlement",
  "labels": {
    "name": "火星创世纪",
    "shortName": "mars",
    "populationNoun": "colonists",
    "settlementNoun": "colony",
    "currency": "credits",
    "eventNoun": "crises",
    "eventNounSingular": "crisis",
    "timeUnitNoun": "year",
    "timeUnitNounPlural": "years",
    "actorNoun": "commander",
    "actorNounPlural": "commanders",
    "tagline": "100 名居民在严酷环境中建立首个永久火星殖民地。愿景家偏好大胆试验，工程师依赖成熟系统，六维人格影响每一次危机决策。"
  },
